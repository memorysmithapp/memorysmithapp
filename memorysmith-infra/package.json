{
  "name": "@memorysmith/infra",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "All CDK for MemorySmith: stacks, constructs, IAM policies and the pipeline.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "test": "vitest run",
    "served-version": "tsx commands/served-version.ts",
    "release-checks": "tsx commands/release-checks.ts",
    "release-notes": "tsx commands/release-notes.ts",
    "deploy": "cdk deploy",
    "deliver": "tsx commands/deliver.ts",
    "smoke": "tsx commands/smoke.ts",
    "wait-for-dns": "tsx commands/wait-for-dns.ts",
    "wait-for-email-identity": "tsx commands/wait-for-email-identity.ts",
    "publish-release": "tsx commands/publish-release.ts",
    "staging:status": "tsx commands/staging-status.ts",
    "staging:start": "tsx commands/staging-start.ts",
    "onboard": "tsx commands/onboard.ts",
    "destroy-staging": "tsx commands/destroy-staging.ts",
    "staging:destroy": "tsx commands/staging-destroy.ts",
    "recount-storage": "tsx commands/maintenance.ts recount-storage",
    "reproject-links": "tsx commands/maintenance.ts reproject-links",
    "migrate-slots": "tsx commands/maintenance.ts migrate-slots",
    "functional": "playwright test -c functional/playwright.config.ts",
    "agent-eval": "tsx agent-eval/run.ts"
  },
  "dependencies": {
    "@memorysmith/contracts": "workspace:*",
    "@aws-sdk/client-cloudformation": "^3.1131.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1131.0",
    "@aws-sdk/client-codebuild": "^3.1131.0",
    "@aws-sdk/client-codepipeline": "^3.1131.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1117.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-secrets-manager": "^3.1117.0",
    "@aws-sdk/client-sesv2": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.1131.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "aws-cdk": "^2.1138.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.4",
    "typescript": "~5.7.3"
  }
}
