# An installation of MemorySmith in your own AWS account (#342).
#
# Copy to .env.production or .env.staging, one file per environment, on the
# command path; on a fork, the same names are variables of the GitHub or GitLab
# environment. Then: pnpm -C memorysmithapp-infra install-account --environment <name>

# Required. Joins the name of everything AWS keeps unique, so two installations
# can share an account: up to 16 lowercase letters, digits and hyphens.
INSTALLATION=acme

# Required. The account and the region. The credentials must belong to the account.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1

# Both or neither. With both, the installation answers under a public hosted zone
# of the account, already delegated. With neither, on the default endpoints of AWS.
DOMAIN_NAME=
HOSTED_ZONE_ID=

# Optional. Zones below DOMAIN_NAME that this environment delegates, as
# name:server,server and separated by ;
# DNS_DELEGATIONS=stg:ns-1.awsdns-01.org,ns-2.awsdns-02.com

# Required in production, which holds the budgets, and with alarms. Never commit it.
ALARM_EMAIL=

# Default endpoints only: an address verified in SES, which the product writes from.
SENDER_ADDRESS=

# github, gitlab, or none for the command path, the default. REPOSITORY is
# owner/name on GitHub and group/project on GitLab, and is required on a fork.
REPOSITORY_HOST=none
REPOSITORY=

# Optional. The start of the `sub` of a GitHub token, when the repository signs
# with immutable ids; repo:<REPOSITORY> otherwise.
# REPOSITORY_SUBJECT=

# Optional. The host of a GitLab of your own; gitlab.com otherwise.
# GITLAB_ISSUER=gitlab.example.com

# Optional, off unless true (ADR-021): what costs money.
# ALARMS=true
# DASHBOARDS=true
# TRACING=true
# Optional. The organization's identity provider, over OIDC (#395): a client
# of the realm, confidential, with the redirect URI
# https://auth.<DOMAIN_NAME>/oauth2/idpresponse (on the default endpoints, the
# sign-in domain the Identity stack outputs as CognitoDomain, + /oauth2/idpresponse)
# and the scopes openid email profile. All three or none.
# IDP_NAME=Acme
# IDP_ISSUER=https://sso.example.com/realms/acme
# IDP_CLIENT_ID=memorysmith
# The client secret of that client. deliver writes it into Secrets Manager and
# no template holds it; once written, a later delivery may leave it unset.
# Never commit it.
# IDP_CLIENT_SECRET=
# idp signs in only through the provider; idp+password, the default, also
# keeps the password of MemorySmith. With idp, onboard the platform
# administrator with --set-password: onboard signs in with it, and the
# interface reaches the same account through the provider.
# SIGN_IN=idp+password
# What a person of the provider finds on the first sign-in: request, the
# default, an account that asks for a subscription; prepared, only an account
# onboarded beforehand with --federated; automatic, an active subscription of
# IDP_QUOTA (500MB, 1GB or 2GB; 1GB by default).
# IDP_FIRST_SIGN_IN=request
# IDP_QUOTA=1GB
# The claim the address of a person travels in: email, the default, or
# preferred_username where the login is login@domain and that is the address.
# IDP_EMAIL_CLAIM=email
# true takes an address in the claim email that the provider does not assert
# as verified (its email_verified); false by default.
# IDP_TRUST_EMAIL=false
