# An installation of MemorySmith in your own AWS account (#342).
#
# Copy to .env.production or .env.staging, one file per environment, on the
# command path; on a fork, the same names are variables of the GitHub or GitLab
# environment. Then: pnpm -C memorysmithapp-infra install-account --environment <name>

# Required. Joins the name of everything AWS keeps unique, so two installations
# can share an account: up to 16 lowercase letters, digits and hyphens.
INSTALLATION=acme

# Required. The account and the region. The credentials must belong to the account.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1

# Both or neither. With both, the installation answers under a public hosted zone
# of the account, already delegated. With neither, on the default endpoints of AWS.
DOMAIN_NAME=
HOSTED_ZONE_ID=

# Optional. Zones below DOMAIN_NAME that this environment delegates, as
# name:server,server and separated by ;
# DNS_DELEGATIONS=stg:ns-1.awsdns-01.org,ns-2.awsdns-02.com

# Required in production, which holds the budgets, and with alarms. Never commit it.
ALARM_EMAIL=

# Default endpoints only: an address verified in SES, which the product writes from.
SENDER_ADDRESS=

# github, gitlab, or none for the command path, the default. REPOSITORY is
# owner/name on GitHub and group/project on GitLab, and is required on a fork.
REPOSITORY_HOST=none
REPOSITORY=

# Optional. The start of the `sub` of a GitHub token, when the repository signs
# with immutable ids; repo:<REPOSITORY> otherwise.
# REPOSITORY_SUBJECT=

# Optional. The host of a GitLab of your own; gitlab.com otherwise.
# GITLAB_ISSUER=gitlab.example.com

# Optional, off unless true (ADR-021): what costs money.
# ALARMS=true
# DASHBOARDS=true
# TRACING=true
