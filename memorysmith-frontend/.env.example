# Origin of the internal API. REQUIRED: the interface reads and writes through
# the product API and has no offline mode. Without it the app refuses to start
# and says so, rather than quietly answering from somewhere else.
VITE_API_ORIGIN=

# The Cognito hosted UI of the user pool, and the app client of the SPA.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
