# Origin of the internal API. Leave it UNSET and the app reads the bundled seed
# and behaves as a navigable prototype; set it and every read and write is a
# real one against the backend.
VITE_API_ORIGIN=

# The Cognito hosted UI of the user pool, and the app client of the SPA. Only
# needed when VITE_API_ORIGIN is set, because that is when there is anything to
# authenticate against.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
