{
  "name": "@memorysmithapp/core-monolith",
  "version": "0.14.3",
  "private": true,
  "type": "module",
  "description": "The composition root of the modular monolith: the one place that wires the bounded contexts together. Moving to six deployables changes this file, not the contexts.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1156.0",
    "@aws-sdk/client-cloudwatch": "^3.1152.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1117.0",
    "@aws-sdk/client-eventbridge": "^3.1117.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-sesv2": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.1117.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@memorysmithapp/contracts": "workspace:*",
    "@memorysmithapp/kernel": "workspace:*",
    "@memorysmithapp/observability": "workspace:*",
    "@memorysmithapp/svc-access": "workspace:*",
    "@memorysmithapp/svc-audit": "workspace:*",
    "@memorysmithapp/svc-discovery": "workspace:*",
    "@memorysmithapp/svc-knowledge": "workspace:*",
    "@memorysmithapp/svc-portability": "workspace:*",
    "hono": "^4.9.0"
  }
}
