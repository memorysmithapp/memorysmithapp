{
  "name": "@memorysmith/svc-portability",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Portability bounded context: export of a notebook as a readable folder of Markdown files. Zero lock-in is a requirement, not a courtesy.",
  "exports": {
    "./adapters/http": "./src/adapters/http.ts",
    "./adapters/s3": "./src/adapters/s3.ts",
    "./adapters/zip": "./src/adapters/zip.ts",
    "./application": "./src/application/ExportNotebook.ts",
    "./domain": "./src/domain/NotebookDocumentBuilder.ts",
    "./application/import": "./src/application/ImportNotebook.ts",
    "./adapters/dynamo": "./src/adapters/dynamo.ts",
    "./application/transfers": "./src/application/Transfers.ts",
    "./application/uploads": "./src/application/Uploads.ts",
    "./domain/transfer": "./src/domain/Transfer.ts",
    "./adapters/sqs": "./src/adapters/sqs.ts",
    "./adapters/memory": "./src/adapters/memory.ts",
    "./application/prints": "./src/application/Prints.ts",
    "./adapters/prints": "./src/adapters/prints.ts",
    "./adapters/chromium": "./src/adapters/chromium.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1117.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@memorysmith/contracts": "workspace:*",
    "@memorysmith/kernel": "workspace:*",
    "@sparticuz/chromium": "153.0.0",
    "hono": "^4.13.3",
    "puppeteer-core": "25.11.0"
  }
}
